# Cockpit
NEXT_PUBLIC_QADAM_ORCHESTRATOR_URL=http://localhost:8717
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Runtime
QADAM_ENV=local
QADAM_MODE=paper
QADAM_TRIAL_BALANCE_GBP=1000
QADAM_FOUNDING_MANAGER_ALLOWLIST=raminhoodeh@gmail.com,troycookecareer@gmail.com,isioras@yahoo.co.uk
QADAM_PENDING_FOUNDING_MANAGERS=Akber,Anas
QADAM_HEALTH_HOST=127.0.0.1
QADAM_HEALTH_PORT=8717
DATABASE_URL=postgresql://qadam:qadam@localhost:5432/qadam
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000

# Local-first storage
QADAM_DATA_ROOT=./data
QADAM_RAW_PAYLOAD_DIR=./data/raw_payloads
QADAM_RUNTIME_DIR=./data/runtime
QADAM_POSTGRES_DATA_DIR=./data/postgres
QADAM_CHROMA_PERSIST_DIR=./data/chroma
QADAM_LOCAL_BACKUP_DIR=./data/backups
QADAM_SECRETS_FILE=./data/runtime/qadam-secrets.env

# Quantum provider credentials
# Store real values in QADAM_SECRETS_FILE or macOS Keychain later; never commit them.
