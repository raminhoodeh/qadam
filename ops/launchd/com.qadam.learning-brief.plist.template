<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.qadam.learning-brief</string>
  <key>ProgramArguments</key>
  <array>
    <string>__QADAM_ROOT__/.venv/bin/python</string>
    <string>__QADAM_ROOT__/scripts/run_scheduled_daily_learning_brief.py</string>
  </array>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>WorkingDirectory</key>
  <string>__QADAM_ROOT__</string>
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key>
      <integer>8</integer>
      <key>Minute</key>
      <integer>2</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>20</integer>
      <key>Minute</key>
      <integer>2</integer>
    </dict>
  </array>
  <key>ProcessType</key>
  <string>Background</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>QADAM_LIVE_CAPITAL_ENABLED</key>
    <string>false</string>
    <key>QADAM_DAILY_LEARNING_AUTOMATION_LOCAL_TIMES</key>
    <string>08:00,20:00</string>
  </dict>
  <key>StandardOutPath</key>
  <string>__QADAM_ROOT__/data/runtime/qadam-learning-brief.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__QADAM_ROOT__/data/runtime/qadam-learning-brief.stderr.log</string>
</dict>
</plist>
