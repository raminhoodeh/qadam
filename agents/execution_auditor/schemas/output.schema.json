{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Execution Auditor Output",
  "type": "object",
  "required": ["agent_key", "status", "venue_key", "ready", "reason", "execution_allowed", "paper_order_allowed", "broker_write_allowed", "boundary"],
  "properties": {
    "agent_key": { "const": "execution_auditor" },
    "status": { "type": "string" },
    "venue_key": { "type": "string" },
    "ready": { "type": "boolean" },
    "reason": { "type": "string" },
    "execution_allowed": { "type": "boolean", "const": false },
    "paper_order_allowed": { "type": "boolean", "const": false },
    "broker_write_allowed": { "type": "boolean", "const": false },
    "boundary": { "type": "string" }
  },
  "additionalProperties": true
}
