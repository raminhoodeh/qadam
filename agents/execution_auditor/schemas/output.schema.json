  "properties": {
    "agent_key": { "const": "execution_auditor" },
    "status": { "type": "string" },
    "venue_key": { "type": "string" },
    "ready": { "type": "boolean" },
    "reason": { "type": "string" }
  },
  "additionalProperties": true
}
