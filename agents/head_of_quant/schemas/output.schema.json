{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Head Of Quant Output",
  "type": "object",
  "required": ["agent_key", "status", "summary", "backend", "fallback", "execution_allowed", "paper_order_allowed", "broker_write_allowed", "boundary"],
  "properties": {
    "agent_key": { "const": "head_of_quant" },
    "status": { "type": "string" },
    "summary": { "type": "string" },
    "backend": { "type": "string" },
    "fallback": { "type": "string" },
    "execution_allowed": { "type": "boolean", "const": false },
    "paper_order_allowed": { "type": "boolean", "const": false },
    "broker_write_allowed": { "type": "boolean", "const": false },
    "boundary": { "type": "string" }
  },
  "additionalProperties": false
}
