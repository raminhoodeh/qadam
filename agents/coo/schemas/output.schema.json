{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "COO Output",
  "type": "object",
  "required": ["agent_key", "status", "summary", "evidence_refs", "next_actions", "execution_allowed", "paper_order_allowed", "broker_write_allowed", "boundary"],
  "properties": {
    "agent_key": { "const": "coo" },
    "status": { "type": "string" },
    "summary": { "type": "string" },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "next_actions": { "type": "array", "items": { "type": "string" } },
    "execution_allowed": { "type": "boolean", "const": false },
    "paper_order_allowed": { "type": "boolean", "const": false },
    "broker_write_allowed": { "type": "boolean", "const": false },
    "boundary": { "type": "string" }
  },
  "additionalProperties": true
}
