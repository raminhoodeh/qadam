{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Strategy Lead Output",
  "type": "object",
  "required": ["agent_key", "status", "thesis", "evidence_refs", "invalidation", "execution_allowed", "paper_order_allowed", "broker_write_allowed", "boundary"],
  "properties": {
    "agent_key": { "const": "strategy_lead" },
    "status": { "type": "string" },
    "thesis": { "type": "string" },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "invalidation": { "type": "string" },
    "execution_allowed": { "type": "boolean", "const": false },
    "paper_order_allowed": { "type": "boolean", "const": false },
    "broker_write_allowed": { "type": "boolean", "const": false },
    "boundary": { "type": "string" }
  },
  "additionalProperties": false
}
