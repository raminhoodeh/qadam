{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qadam.local-research-assessment.v1",
  "title": "Qadam Local Research Assessment",
  "type": "object",
  "required": [
    "summary",
    "watch_focus",
    "anomalies",
    "missing_correlations",
    "next_questions",
    "escalation_recommendation",
    "confidence"
  ],
  "properties": {
    "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
    "watch_focus": {"type": "string", "minLength": 1, "maxLength": 1000},
    "anomalies": {
      "type": "array",
      "maxItems": 20,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "missing_correlations": {
      "type": "array",
      "maxItems": 20,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "next_questions": {
      "type": "array",
      "maxItems": 20,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "escalation_recommendation": {
      "enum": ["hold_shadow", "escalate_to_strategy_lead_shadow"]
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "additionalProperties": false
}
