{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Signal Auditor Output",
  "type": "object",
  "required": ["agent_key", "status", "passed", "reason", "evidence_refs", "execution_allowed", "paper_order_allowed", "broker_write_allowed", "boundary"],
  "properties": {
    "agent_key": { "const": "signal_auditor" },
    "status": { "type": "string" },
    "passed": { "type": "boolean" },
    "reason": { "type": "string" },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "execution_allowed": { "type": "boolean", "const": false },
    "paper_order_allowed": { "type": "boolean", "const": false },
    "broker_write_allowed": { "type": "boolean", "const": false },
    "boundary": { "type": "string" }
  },
  "additionalProperties": true
}
